{
  "name": "xerox-station",
  "version": "1.0.0",
  "description": "XeroxStation - print-shop owner app (Electron + Web + PWA)",
  "main": "electron/main.js",
  "author": "Shop Owner",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "dev": "node scripts/copy-assets.mjs && vite",
    "build": "node scripts/copy-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/copy-assets.mjs && concurrently -k \"vite --mode electron\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:build": "node scripts/copy-assets.mjs && tsc --noEmit && vite build --mode electron && electron-builder --win --x64"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pdf-to-printer": "^5.6.0",
    "peer": "^1.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "idb": "^8.0.0",
    "lucide-react": "^0.400.0",
    "pdf-lib": "^1.17.1",
    "peerjs": "^1.5.4",
    "postcss": "^8.4.38",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-pwa": "^0.20.0",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.4"
  },
  "build": {
    "appId": "com.xerox.station",
    "productName": "XeroxStation",
    "directories": { "output": "release", "buildResources": "build" },
    "electronDist": "node_modules/electron/dist",
    "files": ["dist/**", "electron/**", "package.json"],
    "asarUnpack": ["node_modules/pdf-to-printer/dist/**"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
